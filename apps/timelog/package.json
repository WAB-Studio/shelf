{
  "name": "timelog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-3300}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache",
    "typecheck": "tsgo --noEmit --incremental false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local ../../node_modules/drizzle-kit/bin.cjs migrate",
    "check:unit": "node --import tsx --test \"{app,lib,components,scripts}/**/*.test.ts\"",
    "check:db": "node --import tsx --env-file=.env.local --test scripts/check-db.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@radix-ui/themes": "^3.3.0",
