    "@supabase/supabase-js": "^2.112.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "mcp-handler": "^2.2.0",
    "next": "16.4.1",
    "next-intl": "^4.13.7",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
