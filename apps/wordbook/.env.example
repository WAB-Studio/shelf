# MyMemory translation provider (https://mymemory.translated.net/doc/spec.php).
# Both variables are optional: the app calls MyMemory anonymously with neither set.

# Registering an email with MyMemory raises its free daily quota from
# roughly 5,000 words to 10,000.
TRANSLATE_MYMEMORY_EMAIL=

# A paid MyMemory key, only if volume ever outgrows the free tier.
TRANSLATE_MYMEMORY_KEY=

# The reader's account copy (RL-22), on the same Supabase project as
# apps/orbit, reached through the `reading` schema.

# Supabase transaction pooler (port 6543) — the running app.
DATABASE_URL=
# Supabase session pooler (port 5432) — drizzle-kit migrations only.
MIGRATION_DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=
