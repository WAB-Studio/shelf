# Supabase transaction pooler (port 6543) — the running app.
DATABASE_URL=
# Supabase session pooler (port 5432) — drizzle-kit migrations only.
MIGRATION_DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=
# Server only: Auth's admin API sends the member invitation (RF-148). Unset, inviting warns that no mail went.
SUPABASE_SECRET_KEY=

# Shared secret for the scheduled jobs endpoint, 16 characters minimum.
CRON_SECRET=

# Server only (RF-187): Resend Inbound's webhook signing secret and an API key that reads a received email.
INBOUND_EMAIL_WEBHOOK_SECRET=
RESEND_API_KEY=
# Server only (RF-192): the Google OAuth client shown in Ajustes for aw-timelog's Gmail connection. Unset, Ajustes shows a note.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Server only (RF-194): fine-grained GitHub token, Contents read-only on WAB-Studio/homefund-android. Unset, Ajustes says the APK is not ready.
ANDROID_APK_GITHUB_TOKEN=
