{
  "name": "homefund",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache",
    "typecheck": "tsgo --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local ../../node_modules/drizzle-kit/bin.cjs migrate",
    "db:check-rls": "TSX_TSCONFIG_PATH=scripts/harness/tsconfig.json node --import tsx --env-file=.env.local scripts/check-rls.ts",
    "check:unit": "node --import tsx --test \"{lib,components}/**/*.test.ts\"",
    "check:queries": "TSX_TSCONFIG_PATH=scripts/harness/tsconfig.json node --import tsx --env-file=.env.local scripts/check-queries.ts",
    "check:sign-in": "TSX_TSCONFIG_PATH=scripts/harness/tsconfig.json node --import tsx --env-file=.env.local scripts/check-sign-in.ts",
    "check:http": "TSX_TSCONFIG_PATH=scripts/harness/tsconfig.json node --import tsx --env-file=.env.local scripts/check-http.ts",
    "check:e2e": "node --env-file=.env.local ../../node_modules/@playwright/test/cli.js test",
    "harness:token": "TSX_TSCONFIG_PATH=scripts/harness/tsconfig.json node --import tsx --env-file=.env.local scripts/harness/mint-harness-token.ts",
    "harness:census": "TSX_TSCONFIG_PATH=scripts/harness/tsconfig.json node --import tsx --env-file=.env.local scripts/harness/census.ts",
    "harness:reap": "TSX_TSCONFIG_PATH=scripts/harness/tsconfig.json node --import tsx --env-file=.env.local scripts/harness/reap.ts",
    "harness:adopt": "TSX_TSCONFIG_PATH=scripts/harness/tsconfig.json node --import tsx --env-file=.env.local scripts/harness/adopt-legacy.ts",
    "seed:year": "TSX_TSCONFIG_PATH=scripts/harness/tsconfig.json node --import tsx --env-file=.env.local scripts/seed-year.ts",
    "seed:year:drop": "npm run seed:year -- drop",
    "seed:demo": "TSX_TSCONFIG_PATH=scripts/harness/tsconfig.json node --import tsx --env-file=.env.local scripts/seed-demo.ts",
    "seed:demo:drop": "npm run seed:demo -- drop",
    "allow-email": "node --import tsx --env-file=.env.local scripts/allow-email.ts",
    "check": "npm run db:check-rls && npm run check:queries && npm run check:http"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/themes": "^3.3.0",
    "@repo/supabase-auth": "*",
    "@repo/zip-guard": "*",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^9.2.4",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.34.0",
    "next": "16.4.1",
    "next-intl": "^4.13.7",
    "next-safe-action": "^8.6.1",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "~3.10.0",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@repo/harness-registry": "*",
    "@types/node": "^22",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
