{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "crons": [
    { "path": "/api/cron/keepalive", "schedule": "0 11 * * *" },
    { "path": "/api/cron/reminders", "schedule": "0 12 * * *" }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  }
}
