          "name": "one_offs_update_self",
          "as": "PERMISSIVE",
          "for": "UPDATE",
          "to": [
            "authenticated"
          ],
          "using": "(select auth.uid()) = \"goals\".\"one_offs\".\"user_id\" and (\"goals\".\"one_offs\".\"day\" is null or \"goals\".\"one_offs\".\"day\" > (now() at time zone 'America/Bogota')::date) and not exists (\n        select 1 from \"goals\".\"facts\" f where f.one_off_id = \"goals\".\"one_offs\".\"id\"\n      )",
          "withCheck": "(select auth.uid()) = \"goals\".\"one_offs\".\"user_id\" and (\"goals\".\"one_offs\".\"day\" is null or not exists (\n        select 1 from \"goals\".\"one_offs\" c where c.parent_id = \"goals\".\"one_offs\".\"id\"\n      ))"
        }
      },
