          "value": "(\"goals\".\"commitments\".\"cadence_kind\" in ('times_per_week', 'every_n_days', 'times_per_month')) = (\"goals\".\"commitments\".\"cadence_n\" is not null and \"goals\".\"commitments\".\"cadence_n\" > 0)"
