          "value": "case when \"goals\".\"commitments\".\"cadence_kind\" = 'weekdays' then coalesce(array_length(\"goals\".\"commitments\".\"cadence_weekdays\", 1), 0) > 0 else \"goals\".\"commitments\".\"cadence_weekdays\" is null end"
