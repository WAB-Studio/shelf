          "for": "INSERT",
          "to": [
            "authenticated"
          ],
          "withCheck": "(select auth.uid()) = \"goals\".\"one_offs\".\"user_id\" and (\"goals\".\"one_offs\".\"parent_id\" is null or exists (\n        select 1 from \"goals\".\"one_offs\" p\n        where p.id = \"goals\".\"one_offs\".\"parent_id\" and p.parent_id is null and p.planned_month is not null\n          and p.day is null and p.estimate is null and p.goal_id = \"goals\".\"one_offs\".\"goal_id\"\n          and not exists (select 1 from \"goals\".\"facts\" f where f.one_off_id = p.id)\n      ))"
        },
        "one_offs_delete_self": {
          "name": "one_offs_delete_self",
          "as": "PERMISSIVE",
          "for": "DELETE",
          "to": [
            "authenticated"
          ],
          "using": "(select auth.uid()) = \"goals\".\"one_offs\".\"user_id\" and not exists (\n        select 1 from \"goals\".\"facts\" f where f.one_off_id = \"goals\".\"one_offs\".\"id\"\n      ) and not exists (\n        select 1 from \"goals\".\"one_offs\" c join \"goals\".\"facts\" f on f.one_off_id = c.id\n        where c.parent_id = \"goals\".\"one_offs\".\"id\"\n      )"
        },
