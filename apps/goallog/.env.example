# The goal log, on the same Supabase project as apps/orbit and apps/voyager.

# Supabase transaction pooler (port 6543) — the running app.
DATABASE_URL=
# Supabase session pooler (port 5432) — drizzle-kit migrations only.
MIGRATION_DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# OpenAI key for reading an imported plan; unset, the import is off.
OPENAI_API_KEY=
# Test servers only: draft:<path to a JSON file> | fail | invalid | empty. Ignored when VERCEL is set.
PULSAR_MODEL_STUB=
# Whole-app daily cap on model calls (RP-126); default 350 when unset
APP_MODEL_CALLS_DAILY_CAP=
