# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Binaries: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# The dictionary asset and its manifest are generated, not authored: never
# diff them, and never let a merge treat them as prose.
apps/wordbook/public/dictionary/*.json -diff linguist-generated
