{
  "name": "monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run dev -w apps/homefund",
    "dev:wordbook": "npm run dev -w apps/wordbook",
    "dev:goallog": "npm run dev -w apps/goallog",
    "build": "npm run build -w apps/homefund",
    "build:wordbook": "npm run build -w apps/wordbook",
    "build:goallog": "npm run build -w apps/goallog",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check": "npm run check -w apps/homefund"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.15.47": true,
    "unrs-resolver@1.12.2": true
  }
}
